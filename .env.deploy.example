# Copia a .env (junto a docker-compose.yml) en el VPS y rellena.
# NO se commitea (.env está en .gitignore).

# Tu dominio, sin https:// ni barra final. Ej: classm8.midominio.com
DOMAIN=TU_DOMINIO.com

# Postgres
POSTGRES_USER=classm8
POSTGRES_PASSWORD=genera-una-clave-fuerte
POSTGRES_DB=classm8

# Google OAuth (Google Cloud > Credenciales)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# JWT propio: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=genera-uno-largo-y-aleatorio
